########## APP ##########
APP_NAME=comment-service
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082

########## MONGODB DATABASE ##########
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=commentdb
MONGODB_USERNAME=comment_user
MONGODB_PASSWORD=1234
MONGODB_AUTH_DATABASE=admin

# MongoDB Connection Pool Settings
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_IDLE_TIME=30000
MONGODB_MAX_LIFE_TIME=60000

# MongoDB Timeout Settings
MONGODB_CONNECT_TIMEOUT=10000
MONGODB_SOCKET_TIMEOUT=30000
MONGODB_SERVER_SELECTION_TIMEOUT=30000


########## LOGGING ##########
LOG_LEVEL=INFO
LOG_LEVEL_APP=DEBUG
MONGODB_LOG_LEVEL=DEBUG
SPRING_WEB_LOG_LEVEL=DEBUG
USER_CACHE_LOG_LEVEL=DEBUG 