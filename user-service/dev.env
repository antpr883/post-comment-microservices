# Post Service Environment Variables
SERVER_PORT=8083
APP_NAME=user-service

# JPA Configuration
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_HIBERNATE_DEFAULT_SCHEMA=v1_user

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=users
DB_USERNAME=user_serv
DB_PASSWORD=1234
DB_DRIVER=org.postgresql.Driver
DB_PARAMS=ssl=false
DB_SCHEMA=${SPRING_JPA_HIBERNATE_DEFAULT_SCHEMA}


# Liquibase Configuration
SPRING_LIQUIBASE_ENABLED=true
SPRING_LIQUIBASE_CHANGE_LOG=classpath:db/changelog/db.changelog-master.xml
SPRING_LIQUIBASE_DEFAULT_SCHEMA=${SPRING_JPA_HIBERNATE_DEFAULT_SCHEMA}
SPRING_LIQUIBASE_SCHEMA=${SPRING_JPA_HIBERNATE_DEFAULT_SCHEMA}

# Logging Configuration
LOG_LEVEL=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL_PARAMS=TRACE
SPRING_WEB_LOG_LEVEL=DEBUG
SPRING_SECURITY_LOG_LEVEL=INFO
LIQUIBASE_LOG_LEVEL=INFO